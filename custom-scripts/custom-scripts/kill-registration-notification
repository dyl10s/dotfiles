#!/bin/bash
while true; do
  osascript <<'APPLESCRIPT' >/dev/null 2>&1
tell application "System Events" to tell process "NotificationCenter"
  repeat with g in (groups of scroll area 1 of group 1 of group 1 of window 1)
    if exists (static text "Registration Required" of g) then
      repeat with a in (actions of g)
        if description of a is "Close" then perform a
      end repeat
    end if
  end repeat
end tell
APPLESCRIPT
  sleep 1
done
